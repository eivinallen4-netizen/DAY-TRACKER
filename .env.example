# Leave these empty to use a persistent local SQLite database in data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PORT=4317
# Full origin reachable by the phone and TV. Example: http://192.168.1.10:4317
# Leave blank to derive links from the current browser address.
PUBLIC_URL=
# Set true when hosting behind HTTPS (required for an internet deployment).
COOKIE_SECURE=false
# Only set to 1 if there is exactly one trusted reverse proxy in front of the app.
TRUST_PROXY=0
